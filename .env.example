# Gloss runs without this file. The passphrase, the cookie signing secret and
# the API keys live in the library's database and are set from the Settings page.
# The first time the site starts, the passphrase is gloss. Change it there.
#
# A value set below is used only while Settings has not saved one of its own.
# After you save in Settings, that saved value wins.

# ---- Optional overrides ------------------------------------------------------

# What the family types once on each computer. Unset: the database decides,
# and a fresh database starts at gloss.
# FAMILY_PASSPHRASE=

# Signs the unlock cookie. Unset: a random secret is stored in the database
# on first start. Changing the saved secret signs every computer out.
# SESSION_SECRET=

# Send the unlock cookie only over HTTPS. Unset: follow how each request
# arrived, which suits plain HTTP on the home network and HTTPS behind a proxy.
# COOKIE_SECURE=true

# ---- AI ----------------------------------------------------------------------

# OpenRouter, for answers, sorting, scanned PDF pages and painted covers.
# Unset: paste a key in Settings. Without one, the library still works.
# OPENROUTER_API_KEY=

# Exa web search, so answers can look things up. Unset: paste a key in Settings.
# EXA_API_KEY=

# The model for each job, by OpenRouter id. Settings in the app override these;
# unset, the built-in defaults are used.
# OPENROUTER_MODEL_CHAT=google/gemini-2.5-flash
# OPENROUTER_MODEL_STRUCTURED=google/gemini-2.5-flash
# OPENROUTER_MODEL_VISION=google/gemini-2.5-flash
# OPENROUTER_MODEL_IMAGE=google/gemini-2.5-flash-image

# ---- Hosting -----------------------------------------------------------------

# Where the SQLite database lives. The Docker image sets /data.
# DATA_DIR=./data

# The address the library is reached at, for links handed to agents.
# NEXT_PUBLIC_SITE_URL=http://gloss.home:3100
