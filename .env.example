# ---- The gate --------------------------------------------------------------

# The family passphrase. Anyone who types it on a computer stays unlocked there.
# Leave empty only for local development: with no passphrase the site is open.
FAMILY_PASSPHRASE=

# A long random string that signs the unlock cookie. Changing it (or the
# passphrase) signs every computer out. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Send the unlock cookie only over HTTPS. Unset: follow how each request
# arrived, which suits plain HTTP on the home network and HTTPS behind a proxy.
# COOKIE_SECURE=true

# ---- AI ----------------------------------------------------------------------

# OpenRouter, for answers, sorting, scanned PDF pages and painted covers.
# Optional: without it the library still works, just without the AI parts.
OPENROUTER_API_KEY=

# Exa web search, so answers can look things up. Optional.
EXA_API_KEY=

# The model for each job, by OpenRouter id. Settings in the app override these;
# unset, the built-in defaults are used.
# OPENROUTER_MODEL_CHAT=google/gemini-2.5-flash
# OPENROUTER_MODEL_STRUCTURED=google/gemini-2.5-flash
# OPENROUTER_MODEL_VISION=google/gemini-2.5-flash
# OPENROUTER_MODEL_IMAGE=google/gemini-2.5-flash-image

# ---- Hosting -----------------------------------------------------------------

# Where the SQLite database lives. The Docker image sets /data.
# DATA_DIR=./data

# The address the library is reached at, for links handed to agents.
# NEXT_PUBLIC_SITE_URL=http://gloss.home:3100
